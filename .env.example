# Copy to .env. Never commit .env. No real secrets belong in this file.

# --- Local development ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://lof:CHANGE_ME@127.0.0.1:5432/lof
BCRYPT_ROUNDS=12
COOKIE_SECURE=0
UPLOAD_DIR=./server/uploads
STORAGE_DRIVER=local

# --- Production, single server (Docker) ---
# NODE_ENV=production
# HOST=0.0.0.0
# SERVE_WEB=1
# COOKIE_SECURE=1

# --- Production, Vercel ---
# Required. Managed Postgres. Add ?sslmode=require for Neon, Supabase, Render.
# DATABASE_URL=
# DATABASE_SSL=1
# DATABASE_SSL_REJECT_UNAUTHORIZED=0
# COOKIE_SECURE=1
# PG_POOL_MAX=5
#
# Required for salons and chat across several Vercel instances.
# REDIS_URL=
#
# Optional if REDIS_URL is absent. Rate limit only, not Socket.IO.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Required on Vercel. The local folder server/uploads is not persistent there.
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=1
#
# Public path, not a secret. Set it when the site uses a custom domain on Vercel.
# VITE_SOCKET_PATH=/api/socket.io
#
# Optional. Same-origin hosting does not need it.
# CORS_ORIGIN=
#
# Supabase is not connected. Do not put a service role key in VITE_*.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
